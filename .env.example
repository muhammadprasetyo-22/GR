# =================================================================
# GUYUB RUKUN - ENVIRONMENT VARIABLES CONFIGURATION (.env)
# =================================================================
# Panduan: Salin file ini menjadi '.env' di direktori akar project.
# Di platform hosting seperti Vercel / Netlify, tambahkan variabel di bawah
# pada menu Settings > Environment Variables sebelum melakukan deployment.

# -----------------------------------------------------------------
# 1. DATABASE & SERVER AUTHENTICATION (BACKEND / NODE.JS)
# -----------------------------------------------------------------
# MONGODB_URI: Connection string ke basis data MongoDB (Local / MongoDB Atlas)
# Contoh: mongodb+srv://username:password@cluster.mongodb.net/guyubrukun?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/guyubrukun"

# MONGODB_DB_NAME: Nama basis data MongoDB yang digunakan
MONGODB_DB_NAME="guyubrukun"

# JWT_SECRET: Kunci rahasia untuk enkripsi token JWT sesi pengguna (Minimal 24 karakter acak)
JWT_SECRET="guyubrukun_prod_jwt_secret_key_2026_secured_min24chars"

# PORT / APP_PORT: Port server Express (Default: 3000)
PORT=3000

# -----------------------------------------------------------------
# 2. AI SERVICES & INTEGRATIONS
# -----------------------------------------------------------------
# GEMINI_API_KEY: Key API Google Gemini AI untuk asisten Smart RT AI
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# -----------------------------------------------------------------
# 3. FIREBASE CONFIGURATION (CLIENT VITE & SERVER)
# -----------------------------------------------------------------
# Variabel dengan awalan VITE_ dikirim ke bundle Klien secara aman tanpa membocorkan kredensial rahasia server.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="guyub-rukun-196a8"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DB_ID="(default)"

# -----------------------------------------------------------------
# 4. DOMAIN & HOSTING URL CONFIGURATION
# -----------------------------------------------------------------
# APP_URL: Domain URL utama aplikasi untuk callback & CORS
APP_URL="http://localhost:3000"
NODE_ENV="development"
